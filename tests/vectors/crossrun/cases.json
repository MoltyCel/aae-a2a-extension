      "client_side": "required",
      "request_part": {"skill": "place-order", "transaction": {"amount": 120, "currency": "EUR", "items": [{"sku": "PAPER-A4", "qty": 20}]}},
      "aae": "valid", "challenge_response": "valid", "activate": true,
      "expect": {"kind": "task", "task_state": "TASK_STATE_COMPLETED", "verdict": "ACCEPT",
